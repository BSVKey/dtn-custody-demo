[2.283,"o","\u001b[90m﹣ LIVE: delivery binds to a real on-chain BSV settlement \u001b[90m(0.0794ms)\u001b[39m # SKIP\u001b[39m\r\n"]
[2.292,"o","\u001b[32m✔ a well-formed 2-hop custody chain verifies \u001b[90m(5.0115ms)\u001b[39m\u001b[39m\r\n"]
