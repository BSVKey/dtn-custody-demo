[2.251,"o","\u001b[32m✔ opReturnCarriesRoot: finds the root in an OP_RETURN output \u001b[90m(0.9678ms)\u001b[39m\u001b[39m\r\n"]
[2.251,"o","\u001b[32m✔ opReturnCarriesRoot: false when the root is absent \u001b[90m(0.1838ms)\u001b[39m\u001b[39m\r\n"]
[2.251,"o","\u001b[32m✔ live delivery composition: unbound is refused before any chain read \u001b[90m(2.6951ms)\u001b[39m\u001b[39m\r\n"]
[2.251,"o","\u001b[90m﹣ LIVE: delivery binds to a real on-chain BSV settlement \u001b[90m(0.087ms)\u001b[39m # SKIP\u001b[39m\r\n"]
[2.268,"o","\u001b[32m✔ a well-formed 2-hop custody chain verifies \u001b[90m(8.7813ms)\u001b[39m\u001b[39m\r\n"]
[2.268,"o","\u001b[32m✔ each receipt is individually authentic \u001b[90m(1.3204ms)\u001b[39m\u001b[39m\r\n"]
[2.269,"o","\u001b[32m✔ a forged signature is caught \u001b[90m(1.3178ms)\u001b[39m\u001b[39m\r\n"]
[2.269,"o","\u001b[32m✔ a missing hop is caught (wrong count) \u001b[90m(0.7414ms)\u001b[39m\u001b[39m\r\n"]
[2.269,"o","\u001b[32m✔ a signer that is not the pinned hop key is caught \u001b[90m(1.7021ms)\u001b[39m\u001b[39m\r\n"]
[2.269,"o","\u001b[32m✔ a broken prevHop link is caught \u001b[90m(0.9686ms)\u001b[39m\u001b[39m\r\n"]
[2.279,"o","\u001b[32m✔ the delivery receipt is authentic \u001b[90m(1.5079ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ bound to the txid the verifier paid: accepted \u001b[90m(0.7686ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ bound to a different txid (replay/transfer): refused \u001b[90m(0.1253ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ unbound (no expected settlement): refused, not silently passed \u001b[90m(0.2048ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ wrong payTo / understated amount refused \u001b[90m(0.1181ms)\u001b[39m\u001b[39m\r\n"]
[2.312,"o","\u001b[32m✔ criterion 1: chunks arrive OUT OF ORDER and each verifies against the root \u001b[90m(13.192ms)\u001b[39m\u001b[39m\r\n"]
[2.313,"o","\u001b[32m✔ criterion 1b: a tampered chunk is rejected \u001b[90m(4.2142ms)\u001b[39m\u001b[39m\r\n"]
[2.313,"o","\u001b[32m✔ criterion 1c: the payload reassembles exactly \u001b[90m(3.572ms)\u001b[39m\u001b[39m\r\n"]
[2.313,"o","\u001b[32m✔ criterion 2: every bundle's custody chain verifies across both hops \u001b[90m(10.1584ms)\u001b[39m\u001b[39m\r\n"]
[2.313,"o","\u001b[32m✔ criterion 3: the occultation produces a gap object with a nonempty delayed set \u001b[90m(4.5221ms)\u001b[39m\u001b[39m\r\n"]
[2.313,"o","\u001b[32m✔ criterion 4: delivery binds to the settlement the verifier paid, refuses otherwise \u001b[90m(5.1055ms)\u001b[39m\u001b[39m\r\n"]
[2.314,"o","\u001b[32m✔ criterion 5: the manifest root re-derives from the received payload \u001b[90m(4.6743ms)\u001b[39m\u001b[39m\r\n"]
[2.323,"o","\u001b[32m✔ gap object records the occultation boundary and the delayed set \u001b[90m(1.4864ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ silence is documented, not lost: a confirmed loss is recorded, not hidden \u001b[90m(0.1439ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ every leaf verifies against the root (even and odd counts) \u001b[90m(2.0963ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a tampered leaf fails its branch \u001b[90m(0.8349ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a valid leaf at the wrong index fails \u001b[90m(0.1865ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ leafHash is domain-separated from internal nodes \u001b[90m(0.1413ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 28\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 27\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 1\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 277.9726\u001b[39m\r\n"]
