[2.306,"o","\r\n> dtn-custody-demo@0.1.0 test\r\n> node --test\r\n\r\n"]
[2.57,"o","\u001b[32m✔ opReturnCarriesRoot: finds the root in an OP_RETURN output \u001b[90m(0.9971ms)\u001b[39m\u001b[39m\r\n"]
[2.57,"o","\u001b[32m✔ opReturnCarriesRoot: false when the root is absent \u001b[90m(0.1499ms)\u001b[39m\u001b[39m\r\n"]
[2.57,"o","\u001b[32m✔ live delivery composition: unbound is refused before any chain read \u001b[90m(4.3413ms)\u001b[39m\u001b[39m\r\n"]
[2.57,"o","\u001b[90m﹣ LIVE: delivery binds to a real on-chain BSV settlement \u001b[90m(0.3695ms)\u001b[39m # SKIP\u001b[39m\r\n"]
[2.58,"o","\u001b[32m✔ a well-formed 2-hop custody chain verifies \u001b[90m(5.5643ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ each receipt is individually authentic \u001b[90m(1.0912ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a forged signature is caught \u001b[90m(0.7433ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a missing hop is caught (wrong count) \u001b[90m(0.3925ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a signer that is not the pinned hop key is caught \u001b[90m(1.6903ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a broken prevHop link is caught \u001b[90m(0.9221ms)\u001b[39m\u001b[39m\r\n"]
[2.587,"o","\u001b[32m✔ the delivery receipt is authentic \u001b[90m(1.754ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ bound to the txid the verifier paid: accepted \u001b[90m(0.6696ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ bound to a different txid (replay/transfer): refused \u001b[90m(0.087ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ unbound (no expected settlement): refused, not silently passed \u001b[90m(0.1474ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ wrong payTo / understated amount refused \u001b[90m(0.0857ms)\u001b[39m\u001b[39m\r\n"]
[2.619,"o","\u001b[32m✔ criterion 1: chunks arrive OUT OF ORDER and each verifies against the root \u001b[90m(9.3595ms)\u001b[39m\u001b[39m\r\n"]
[2.62,"o","\u001b[32m✔ criterion 1b: a tampered chunk is rejected \u001b[90m(3.8177ms)\u001b[39m\u001b[39m\r\n"]
[2.62,"o","\u001b[32m✔ criterion 1c: the payload reassembles exactly \u001b[90m(3.3497ms)\u001b[39m\u001b[39m\r\n"]
[2.62,"o","\u001b[32m✔ criterion 2: every bundle's custody chain verifies across both hops \u001b[90m(9.0272ms)\u001b[39m\u001b[39m\r\n"]
[2.62,"o","\u001b[32m✔ criterion 3: the occultation produces a gap object with a nonempty delayed set \u001b[90m(2.847ms)\u001b[39m\u001b[39m\r\n"]
[2.62,"o","\u001b[32m✔ criterion 4: delivery binds to the settlement the verifier paid, refuses otherwise \u001b[90m(3.446ms)\u001b[39m\u001b[39m\r\n"]
[2.62,"o","\u001b[32m✔ criterion 5: the manifest root re-derives from the received payload \u001b[90m(3.0542ms)\u001b[39m\u001b[39m\r\n"]
[2.62,"o","\u001b[32m✔ criterion 1d: authorship is pinned: a stranger-signed manifest is refused, an unpinned dest refuses \u001b[90m(1.5196ms)\u001b[39m\u001b[39m\r\n"]
[2.621,"o","\u001b[32m✔ criterion 1e: pins compare exactly: a case-flipped copy of a real key or address is refused \u001b[90m(4.0543ms)\u001b[39m\u001b[39m\r\n"]
[2.629,"o","\u001b[32m✔ gap object records the occultation boundary and the delayed set \u001b[90m(1.2688ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ silence is documented, not lost: a confirmed loss is recorded, not hidden \u001b[90m(0.1096ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ every leaf verifies against the root (even and odd counts) \u001b[90m(2.8541ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a tampered leaf fails its branch \u001b[90m(0.8228ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a valid leaf at the wrong index fails \u001b[90m(0.1638ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ leafHash is domain-separated from internal nodes \u001b[90m(0.1066ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 30\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 29\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 1\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 272.5428\u001b[39m\r\n"]
