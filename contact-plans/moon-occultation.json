{
  "name": "moon-occultation",
  "description": "Far-side lander relayed by a lunar orbiter to Earth; real light time (about 1.3 s one way); the orbiter-to-Earth link drops while the orbiter is behind the Moon.",
  "scale": 1,
  "nodes": [
    { "ipn": 1, "name": "far-side lander" },
    { "ipn": 2, "name": "lunar relay orbiter" },
    { "ipn": 3, "name": "Earth ground station" },
    { "ipn": 4, "name": "mission operations" }
  ],
  "links": [
    { "id": "L1", "from": 1, "to": 2 },
    { "id": "L2", "from": 2, "to": 3 },
    { "id": "L3", "from": 3, "to": 4 }
  ],
  "delays": {
    "L1": { "one_way_ms": 20, "loss_pct": 0.5, "reorder_pct": 2, "rate_bps": 256000 },
    "L2": { "one_way_ms": 1300, "loss_pct": 0.5, "reorder_pct": 2, "rate_bps": 2000000 },
    "L3": { "one_way_ms": 50, "loss_pct": 0, "reorder_pct": 0, "rate_bps": 100000000 }
  },
  "contacts": [
    { "link": "L1", "up_s": 0, "down_s": 600 },
    { "link": "L2", "up_s": 0, "down_s": 120 },
    { "link": "L2", "up_s": 300, "down_s": 600, "note": "orbiter behind the Moon from 120 s to 300 s" },
    { "link": "L3", "up_s": 0, "down_s": 600 }
  ],
  "occultation": { "link": "L2", "down_s": 120, "up_s": 300, "expect_gap_object": true }
}
